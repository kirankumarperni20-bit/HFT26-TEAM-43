# ===========================================================================
# AI Research Assistant Configuration Template
# Copy this file to backend/.env (or .env at root) and update the values.
# ===========================================================================

# ---------------------------------------------------------------------------
# Database Configuration (PostgreSQL with pgvector)
# ---------------------------------------------------------------------------
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/research_assistant

# ---------------------------------------------------------------------------
# LLM Configuration (Featherless AI / OpenAI-compatible API)
# ---------------------------------------------------------------------------
LLM_API_KEY=your_featherless_api_key_here
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_MODEL_NAME=Qwen/Qwen3.8-27B
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.3
