# Copy this file to .env.local and adjust values for your environment.
# The VITE_ prefix is required so Vite exposes the variable to the browser bundle.
#
# VITE_API_BASE_URL — base URL of the FastAPI backend (no trailing slash).
# Default used when unset: http://localhost:8000/api
VITE_API_BASE_URL=http://localhost:8000/api
