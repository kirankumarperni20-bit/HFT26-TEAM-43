```gitignore
# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
**/.venv/
venv/
ENV/
env/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Environment variables and secrets
.env
**/.env
*.local

# IDEs and OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# Backend generated data
backend/data/*
!backend/data/.gitkeep
```

backend/.venv